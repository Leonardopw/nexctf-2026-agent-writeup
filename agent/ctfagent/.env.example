# 复制为 .env 后填写；.env 已在 .gitignore 中
# DeepSeek（默认）
CTF_AGENT_API_KEY=
CTF_AGENT_BASE_URL=https://api.deepseek.com
CTF_AGENT_MODEL=deepseek-chat

